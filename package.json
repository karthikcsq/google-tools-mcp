{
  "name": "google-tools-mcp",
  "version": "2.0.0",
  "description": "The easiest MCP server for Google Workspace — Drive, Docs, Sheets, Gmail, Calendar, Forms, Slides, and Tasks. 156 tools with one-click browser auth. Read Word docs, PDFs, and spreadsheets straight from Drive.",
  "type": "module",
  "bin": {
    "google-tools-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "google",
    "google-workspace",
    "google-drive",
    "google-docs",
    "google-sheets",
    "google-calendar",
    "google-forms",
    "gdrive",
    "gmail",
    "email",
    "send-email",
    "read-email",
    "email-drafts",
    "email-labels",
    "email-filters",
    "sheets",
    "spreadsheet",
    "docs",
    "calendar",
    "forms",
    "drive",
    "pdf",
    "read-pdf",
    "word",
    "docx",
    "read-docx",
    "file-reader",
    "oauth",
    "easy-auth",
    "browser-auth",
    "claude",
    "ai",
    "llm",
    "ai-tools"
  ],
  "scripts": {
    "local:tool": "node scripts/call-local-tool.js",
    "live-smoke": "node scripts/live-smoke.mjs",
    "live-call": "node scripts/live-smoke/call.mjs",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikcsq/google-tools-mcp.git"
  },
  "homepage": "https://github.com/karthikcsq/google-tools-mcp#readme",
  "bugs": {
    "url": "https://github.com/karthikcsq/google-tools-mcp/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@clack/prompts": "^1.2.0",
    "chalk": "^5.6.2",
    "diff": "^7.0.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "hono": "^4.11.4",
    "mammoth": "^1.9.0",
    "markdown-it": "^14.1.0",
    "pdf-parse": "^1.1.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0"
  }
}
