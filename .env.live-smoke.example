# Live-smoke configuration. Copy to .env.live-smoke (gitignored) and edit.
#
# The Drive folder every live-smoke write is confined to. The runner refuses to
# start without it, and every mutation must resolve, through its parent chain,
# to this folder. Create a throwaway folder in your own Drive and put its id
# here -- everything the run creates inside it is trashed at the end.
#
# The folder used on the maintainer's machine is named
# "google-tools-mcp live smoke (safe to delete)".
GOOGLE_MCP_TEST_FOLDER_ID=15m5wq1pA8Mn0ETxIaLdN0kaUFwnrfzHN

# Optional: quieten the server's own info logging during a run.
# LOG_LEVEL=warn
